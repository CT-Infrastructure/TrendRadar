# ============================================
# Web server settings
# ============================================

# Web server port (default 8080; change it to avoid conflicts)
# Starts automatically in cron mode; view reports at http://localhost:{WEBSERVER_PORT}
WEBSERVER_PORT=8080

# ============================================
# Notification channels (separate multiple accounts with ;)
# ============================================

# Feishu bot webhook URL (separate multiple accounts with ;)
FEISHU_WEBHOOK_URL=
# Telegram bot token (separate accounts with ; and match the chat ID count)
TELEGRAM_BOT_TOKEN=
# Telegram chat ID (separate accounts with ; and match the bot token count)
TELEGRAM_CHAT_ID=
# DingTalk bot webhook URL (separate multiple accounts with ;)
DINGTALK_WEBHOOK_URL=
# WeCom bot webhook URL (separate multiple accounts with ;)
WEWORK_WEBHOOK_URL=
# WeCom message type (markdown or text)
WEWORK_MSG_TYPE=

# Email settings (separate multiple recipients with commas)
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_TO=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=

# ntfy notifications (separate accounts with ; and match topic and token counts)
# ntfy server URL (may be self-hosted)
# Leave empty to use https://ntfy.sh, or enter your self-hosted URL
NTFY_SERVER_URL=
# ntfy topic name (separate multiple accounts with ;)
NTFY_TOPIC=
# Optional access token for private topics (separate accounts with ; and leave empty positions, e.g. ";token2")
NTFY_TOKEN=

# Bark notifications (separate multiple accounts with ;)
BARK_URL=

# Slack notifications (separate multiple accounts with ;)
SLACK_WEBHOOK_URL=

# Generic webhook settings (separate multiple accounts with ;)
# Supports Discord, Matrix, IFTTT, and other webhook-compatible platforms
GENERIC_WEBHOOK_URL=
# JSON template supporting {title} and {content} placeholders
# Example: {"content": "{content}"}
GENERIC_WEBHOOK_TEMPLATE=

# ============================================
# AI settings (shared by ai_analysis and ai_translation)
# ============================================

# Enable AI analysis (true/false)
AI_ANALYSIS_ENABLED=
# AI API key (required when AI features are enabled)
AI_API_KEY=
# Model name (LiteLLM format: provider/model_name)
# Example: deepseek/deepseek-chat, openai/gpt-4o, gemini/gemini-2.5-flash
AI_MODEL=
# Custom API endpoint (optional; usually leave empty)
AI_API_BASE=

# ============================================
# Remote storage settings (S3-compatible; supports R2/OSS/COS/S3)
# ============================================

S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# ============================================
# MCP server settings
# ============================================

# MCP bind address (127.0.0.1 for local access; 0.0.0.0 to allow remote access)
# MCP_HOST=127.0.0.1
# MCP port (default 3333; change it to avoid conflicts)
# MCP_PORT=3333

# ============================================
# Runtime configuration
# ============================================

# Cron schedule: every 30 minutes (e.g. 08:00, 08:30, 09:00, 09:30)
CRON_SCHEDULE=*/30 * * * *
# Run mode: cron/once
RUN_MODE=cron
# Run once immediately on startup
IMMEDIATE_RUN=true
